{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": 180,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#e3e3e3",
      "labelFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFont": "Segoe UI"
    },
    "background": "white"
  },
  "encoding": {
    "x": {
      "field": "MonthName",
      "type": "nominal",
      "sort": {
        "field": "MonthNo"
      },
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Account",
      "type": "nominal",
      "sort": {
        "field": "TL Account Rank"
      },
      "axis": {
        "title": null,
        "labelLimit": 190
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3,
        "stroke": "white",
        "strokeWidth": 4
      },
      "encoding": {
        "color": {
          "field": "TL Variance M",
          "type": "quantitative",
          "scale": {
            "domain": [
              -100,
              0,
              100
            ],
            "range": [
              "#526b7a",
              "#faf8f5",
              "#cf493a"
            ],
            "clamp": true
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Account",
            "type": "nominal"
          },
          {
            "field": "MonthName",
            "type": "nominal"
          },
          {
            "field": "TL Variance M",
            "type": "quantitative",
            "format": "+,.2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "TL Variance M",
          "type": "quantitative",
          "format": "+.0f"
        },
        "color": {
          "condition": {
            "test": "abs(datum[\"TL Variance M\"]) > 70",
            "value": "white"
          },
          "value": "#18232b"
        }
      }
    }
  ]
}