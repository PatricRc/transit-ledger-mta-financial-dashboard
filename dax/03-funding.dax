// TL Funding Dashboard HTML
TL Funding Dashboard HTML =
VAR yy = [TL Year]
VAR showCoverage = SELECTEDVALUE(report_funding_view[View],"$ Gap") = "% Coverage"
VAR annualCash = [TL Annual Cash]/1000000
VAR annualAccrued = [TL Annual Accrual]/1000000
VAR gapValue = annualAccrued-annualCash
VAR annualRatio = DIVIDE(annualCash,annualAccrued)
VAR monthlyFunding = ADDCOLUMNS(GENERATESERIES(1,12),
 "@cash",VAR mm=[Value] RETURN CALCULATE([TL Cash],REMOVEFILTERS(gold_dim_date),gold_dim_date[Year]=yy,gold_dim_date[MonthNumber]=mm)/1000000,
 "@accrued",VAR mm=[Value] RETURN CALCULATE([TL Accrual],REMOVEFILTERS(gold_dim_date),gold_dim_date[Year]=yy,gold_dim_date[MonthNumber]=mm)/1000000)
VAR quarterlyFunding = ADDCOLUMNS(GENERATESERIES(1,4),
 "@qc",VAR qq=[Value] RETURN SUMX(FILTER(monthlyFunding,[Value]>(qq-1)*3 && [Value]<=qq*3),[@cash]),
 "@qa",VAR qq=[Value] RETURN SUMX(FILTER(monthlyFunding,[Value]>(qq-1)*3 && [Value]<=qq*3),[@accrued]))
VAR quarterMarks = CONCATENATEX(quarterlyFunding,
 VAR py=280+([Value]-1)*55
 VAR qGap=[@qa]-[@qc]
 VAR ratio=DIVIDE([@qc],[@qa])
 VAR cashWidth=580*MAX(0,MIN(1,ratio))
 VAR filledColor=IF(ratio>1.001,"url(#overfund)","#4F6A7A")
 RETURN "<text x='490' y='" & py & "' font-size='19' font-weight='700' fill='#1B2F3F'>Q" & [Value] & "</text><text x='560' y='" & py & "' font-size='15' fill='#4F6A7A'>" & FORMAT([@qc],"#,0.0","en-US") & " / " & FORMAT([@qa],"#,0.0","en-US") & "</text><rect x='810' y='" & py-18 & "' width='580' height='26' rx='7' fill='#f8ded8'/><rect x='810' y='" & py-18 & "' width='" & FORMAT(cashWidth,"0.0","en-US") & "' height='26' rx='7' fill='" & filledColor & "'><title>Q" & [Value] & ": cash $" & FORMAT([@qc],"#,0.0","en-US") & "M / accrued $" & FORMAT([@qa],"#,0.0","en-US") & "M; coverage " & FORMAT(ratio,"0.0%") & "</title></rect><path d='M1390 " & py-22 & "v34' stroke='#1B2F3F' stroke-width='2'/><text x='1600' y='" & py & "' font-size='21' font-weight='700' text-anchor='end' fill='" & IF(qGap>0.05,"#D04A3A","#4F6A7A") & "'>" & IF(showCoverage,FORMAT(ratio,"0.0%"),IF(ABS(qGap)<0.05,"≈0.0",FORMAT(qGap,"+0.0;-0.0"))) & "</text>","",[Value],ASC)
VAR maxCash=MAXX(monthlyFunding,[@cash])
VAR topAxis=IF(showCoverage,MAX(1,CEILING(MAXX(monthlyFunding,DIVIDE([@cash],[@accrued])),0.5)),MAX(100,CEILING(maxCash,100)))
VAR gridMarks=CONCATENATEX(GENERATESERIES(0,2),VAR py=775-[Value]*65 RETURN "<path d='M550 " & py & "H1600' stroke='#e3e6e3'/><text x='530' y='" & py+5 & "' font-size='16' text-anchor='end' fill='#4F6A7A'>" & IF(showCoverage,FORMAT(topAxis*[Value]/2,"0%"),FORMAT(topAxis*[Value]/2,"#,0")) & "</text>","")
VAR cashBars=CONCATENATEX(monthlyFunding,
 VAR px=570+([Value]-1)*87
 VAR shown=IF(showCoverage,DIVIDE([@cash],[@accrued]),[@cash])
 VAR ht=130*DIVIDE(shown,topAxis)
 RETURN "<rect x='" & px & "' y='" & FORMAT(775-ht,"0.0","en-US") & "' width='44' height='" & FORMAT(MAX(ht,1),"0.0","en-US") & "' rx='4' fill='" & IF([Value]=12,"#D04A3A","#4F6A7A") & "'><title>" & FORMAT(DATE(yy,[Value],1),"MMM") & ": cash $" & FORMAT([@cash],"#,0.0","en-US") & "M</title></rect><text x='" & px+22 & "' y='" & FORMAT(767-ht,"0.0","en-US") & "' text-anchor='middle' font-size='16' font-weight='600' fill='" & IF([Value]=12,"#D04A3A","#4F6A7A") & "'>" & IF(showCoverage,FORMAT(DIVIDE([@cash],[@accrued]),"0%"),FORMAT([@cash],"0")) & "</text><text x='" & px+22 & "' y='798' text-anchor='middle' font-size='16' fill='#4F6A7A'>" & FORMAT(DATE(yy,[Value],1),"MMM") & "</text>","",[Value],ASC)
VAR decAccrued=MAXX(FILTER(monthlyFunding,[Value]=12),[@accrued])
VAR decCash=MAXX(FILTER(monthlyFunding,[Value]=12),[@cash])
VAR decShare=DIVIDE(decCash,annualCash)
VAR sparkPoints=CONCATENATEX(monthlyFunding,FORMAT(32+([Value]-1)*32,"0") & "," & FORMAT(586-68*DIVIDE([@cash],MAX(maxCash,1)),"0.0","en-US")," ",[Value],ASC)
RETURN IF([TL Valid Year]<>1,"Select one reporting year",
[_css] & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1640 860' style='display:block;width:100%;height:auto;font-family:Segoe UI,Arial' role='img' aria-label='Funding dashboard: cash coverage of accrued subsidies and monthly cash receipts'><defs><pattern id='overfund' width='10' height='10' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'><rect width='10' height='10' fill='#4F6A7A'/><rect width='4' height='10' fill='#9dafba'/></pattern></defs><rect width='1640' height='860' fill='#F4F4EE'/><text x='0' y='24' font-size='16' font-weight='600' fill='#D04A3A' letter-spacing='1.2'>03 / FUNDING</text><text x='0' y='68' font-size='31' font-weight='700' fill='#1B2F3F'>Cash was $" & FORMAT(ABS(gapValue),"#,0.0","en-US") & "M " & IF(gapValue>=0,"below","above") & " accrued subsidies.</text><text x='0' y='104' font-size='16' fill='#4F6A7A'>Jan–Dec " & yy & " · Selected NYCT subsidy category · Compare cash receipts with accrual separately.</text><rect x='0' y='145' width='430' height='700' rx='20' fill='#1B2F3F'/><rect x='460' y='145' width='1180' height='380' rx='20' fill='white'/><rect x='460' y='545' width='1180' height='300' rx='20' fill='white'/><text x='30' y='184' font-size='16' font-weight='600' fill='#b9cbd6'>CASH / ACCRUAL</text><text x='30' y='250' font-size='52' font-weight='700' fill='white'>" & IF(showCoverage,FORMAT(annualRatio,"0.0%"),"$"&FORMAT(ABS(gapValue),"#,0.0","en-US")&"M") & "</text><text x='30' y='282' font-size='21' font-weight='600' fill='white'>" & IF(showCoverage,"cash / accrued coverage",IF(gapValue>=0,"less cash than accrued","more cash than accrued")) & "</text><path d='M30 340H100L130 315H220L245 345H385' fill='none' stroke='#9bb5c5' stroke-opacity='.4' stroke-width='3'/><circle cx='100' cy='340' r='6' fill='#9bb5c5'/><circle cx='220' cy='315' r='6' fill='#9bb5c5'/><circle cx='385' cy='345' r='6' fill='#D04A3A'/><text x='30' y='390' font-size='16' fill='#b9cbd6'>CASH RECEIVED</text><text x='30' y='428' font-size='31' font-weight='700' fill='white'>$" & FORMAT(annualCash,"#,0.0","en-US") & "M</text><text x='235' y='390' font-size='16' fill='#b9cbd6'>ACCRUED SUBSIDIES</text><text x='235' y='428' font-size='31' font-weight='700' fill='white'>$" & FORMAT(annualAccrued,"#,0.0","en-US") & "M</text><polyline points='" & sparkPoints & "' fill='none' stroke='#b1c3ce' stroke-width='3'/><text x='30' y='617' font-size='16' fill='#b9cbd6'>Monthly cash receipts · Jan–Dec · separate scale</text><path d='M30 653H400' stroke='#ffffff' stroke-opacity='.2'/><circle cx='43' cy='690' r='13' fill='#294b60'/><text x='43' y='696' text-anchor='middle' font-size='18' fill='white'>?</text><text x='70' y='695' font-size='18' font-weight='600' fill='white'>Timing matters</text><text x='30' y='734' font-size='15' fill='#c7d5dc'>Check settlement timing and adjustments</text><text x='30' y='758' font-size='15' fill='#c7d5dc'>before inferring a collection problem.</text><text x='30' y='802' font-size='16' fill='#b9cbd6'>Selected taxes and subsidies; gross scope.</text><text x='30' y='823' font-size='16' fill='#b9cbd6'>Not total organizational cash flow.</text><text x='490' y='184' font-size='23' font-weight='700' fill='#1B2F3F'>Quarterly cash coverage</text><text x='490' y='211' font-size='14' fill='#4F6A7A'>Track ends at 100% of accrued funding · striped blue = cash exceeds accrual</text><text x='490' y='244' font-size='16' fill='#4F6A7A'>Period</text><text x='560' y='244' font-size='16' fill='#4F6A7A'>Cash / accrued ($M)</text><text x='810' y='244' font-size='16' fill='#4F6A7A'>Cash coverage · 100% reference</text><text x='1600' y='244' text-anchor='end' font-size='16' fill='#4F6A7A'>" & IF(showCoverage,"Coverage","Gap $M") & "</text>" & quarterMarks & "<path d='M490 472H1600' stroke='#e3e6e3'/><text x='490' y='506' font-size='15' font-weight='600' fill='#1B2F3F'>" & FORMAT(annualRatio,"0.0%") & " annual coverage</text><text x='1600' y='506' text-anchor='end' font-size='16' fill='#4F6A7A'>Normalized coverage compares timing, not quarterly funding volume.</text><text x='490' y='583' font-size='22' font-weight='700' fill='#1B2F3F'>" & IF(showCoverage,"December cash / accrual coverage: "&FORMAT(DIVIDE(decCash,decAccrued),"0.0%"),"December supplied "&FORMAT(decShare,"0.0%")&" of annual cash receipts") & "</text><text x='490' y='610' font-size='14' fill='#4F6A7A'>" & IF(showCoverage,"Monthly cash / accrual coverage · 100% = parity","Monthly cash subsidy receipts · $ millions · zero baseline") & "</text>" & gridMarks & cashBars & "<text x='490' y='827' font-size='16' fill='#4F6A7A'>Selected dedicated taxes and state/local subsidies · NYCT · Actual · interagency elimination rows excluded</text></svg>")
