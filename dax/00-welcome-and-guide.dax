// TL Welcome HTML
TL Welcome HTML =
VAR yy=[TL Year]
RETURN [_css]&"<div class='tl' style='background:rgba(27,47,63,.82);color:white;padding:56px;border-radius:24px;min-height:740px;position:relative;overflow:hidden'><div style='position:absolute;right:-50px;top:0;opacity:.12;font-size:420px;line-height:1.2'>Ⓜ</div><div style='letter-spacing:4px;color:#D3DEE4;font-size:18px'>DATAPAT.AI / FINANCIAL FIELDNOTES</div><h1 style='font-size:76px;max-width:1100px;font-weight:400;line-height:1.05;margin:80px 0 26px'>Transit Ledger:<br>Where NYC Transit’s<br>money went.</h1><p style='font-size:23px;color:#D3DEE4'>Follow the money. Locate the pressure. Understand the timing.</p><div style='display:flex;gap:100px;margin-top:70px'><div><div class='display' style='font-size:56px'>$"&FORMAT([TL Annual Actual]/1000000000,"0.00")&"B</div><div>Operating expenses · "&yy&"</div></div><div><div class='display' style='font-size:56px'>+$"&FORMAT(([TL Driver 1 Variance]+[TL Driver 2 Variance])/1000000,"#,0.0")&"M</div><div>Top two upward cost drivers</div></div><div><div class='display' style='font-size:56px'>"&FORMAT([TL Annual Coverage Pct],"0.0%")&"</div><div>Cash / accrued subsidies</div></div></div><p style='font-size:16px;color:#D3DEE4;margin-top:70px'>MTA Open Data · NYCT · "&yy&" · Static source snapshot · Not an audited reconciliation</p></div>"

// TL How To Read HTML
TL How To Read HTML =
[_css]&"<div class='tl' style='padding:48px;background:#F4F4EE;min-height:740px'><div style='font-size:17px;color:#B53B2C;letter-spacing:2px'>A QUICK GUIDE / TRANSIT LEDGER</div><h1 style='font-size:60px;font-weight:400'>Read the figures. Ask the next question.</h1><div style='display:flex;gap:28px'><div style='background:white;padding:32px;flex:1;border-radius:20px'><h2>01 / Actual vs adopted budget</h2><p style='font-size:23px;line-height:1.6'>Actual is recorded spending. Adopted budget is the same-year plan. A positive variance means spending above plan; a negative variance means below plan.</p><p style='color:#B53B2C;font-size:24px'>+ Above plan</p><p style='font-size:24px'>− Below plan</p></div><div style='background:#1B2F3F;color:white;padding:32px;flex:1;border-radius:20px'><h2>02 / Cash vs accrual</h2><p style='font-size:23px;line-height:1.6'>Cash shows receipts. Accrual records recognized subsidy amounts. Coverage is cash divided by accrual. Differences can reflect timing and adjustments.</p><p style='font-size:22px'>100% = cash equals accrual</p></div><div style='background:white;padding:32px;flex:1;border-radius:20px'><h2>03 / Variance is not cause</h2><p style='font-size:23px;line-height:1.6'>Charts show where and when the difference occurred. Management commentary is needed to explain why. Funding covers selected taxes and subsidies, not total organizational cash flow.</p></div></div><p style='font-size:21px;margin-top:40px'>Use Year to keep one reporting period throughout. Use Account to inspect the monthly line, Cost Measure for dollar/index views, and Funding View for cash coverage. The Ledger contains exact amounts.</p></div>"

// _css
_css =
"<style>:root{--ink:#1B2F3F;--slate:#4F6A7A;--coral:#D04A3A;--coral-ink:#B53B2C;--coral-on-dark:#FFAA98;--surface:#F4F4EE;--radius:20px}svg text{font-family:Segoe UI,Arial,sans-serif}svg text[font-size='42'],svg text[font-size='29'],svg text[font-size='31'],svg text[font-size='44'],svg text[font-size='52']{font-family:Georgia,serif} .tl{color:var(--ink);font-family:Segoe UI,Arial} .tl h1,.tl .display{font-family:Georgia,serif} .tl .muted{color:var(--slate)} .tl table{border-collapse:collapse;width:100%}.tl th,.tl td{padding:12px 8px;border-bottom:1px solid #dfe4df;text-align:right}.tl th:first-child,.tl td:first-child{text-align:left}.tl th{color:var(--slate);font-weight:600}.tl .pill{border-radius:20px;padding:5px 12px;font-size:16px}.tl .up{color:#B53B2C;background:#FBEAE5}.tl .down{color:#1B2F3F;background:#E5EDF1}svg text[fill='#D04A3A']{fill:#B53B2C}</style>"
