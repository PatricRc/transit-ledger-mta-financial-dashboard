// TL Cost Dashboard HTML
TL Cost Dashboard HTML =
VAR yy = [TL Year]
VAR mode = SELECTEDVALUE(report_cost_view[View], "$ Amount")
VAR indexed = mode = "% Index"
VAR ledgerList = DISTINCT(SELECTCOLUMNS(FILTER(ALL(gold_dim_operating_account),gold_dim_operating_account[Type]="Total Expenses Before Non-Cash Liability Adjs."),"@ledger",gold_dim_operating_account[GeneralLedger]))
VAR amounts = ADDCOLUMNS(ledgerList,
 "@a", VAR ledger = [@ledger] RETURN CALCULATE([TL Annual Actual],REMOVEFILTERS(gold_dim_operating_account),TREATAS({ledger},gold_dim_operating_account[GeneralLedger]))/1000000,
 "@b", VAR ledger = [@ledger] RETURN CALCULATE([TL Annual Budget],REMOVEFILTERS(gold_dim_operating_account),TREATAS({ledger},gold_dim_operating_account[GeneralLedger]))/1000000)
VAR ranked = ADDCOLUMNS(amounts,"@delta",[@a]-[@b])
VAR topFive = TOPN(5,FILTER(ranked,NOT ISBLANK([@a]) && [@delta]>0),[@delta],DESC,[@ledger],ASC)
VAR accountRowsRanked = ADDCOLUMNS(topFive,"@rank",VAR cur = [@delta] VAR nm = [@ledger] RETURN 1+COUNTROWS(FILTER(topFive,[@delta]>cur || ([@delta]=cur && [@ledger]<nm))))
VAR d1 = [TL Driver 1 Name]
VAR d2 = [TL Driver 2 Name]
VAR pressure = ([TL Driver 1 Variance]+[TL Driver 2 Variance])/1000000
VAR maxAxis = IF(indexed,CEILING(MAX(3,MAXX(topFive,DIVIDE([@a],[@b]))),0.5),CEILING(MAXX(topFive,MAX([@a],[@b])),200))
VAR ticks = CONCATENATEX(GENERATESERIES(0,4),VAR xx=830+[Value]*145 RETURN "<path d='M" & xx & " 256V472' stroke='#edf0f0'/><text x='" & xx & "' y='242' font-size='16' fill='#4F6A7A' text-anchor='middle'>" & IF(indexed,FORMAT([Value]*maxAxis/4,"0%"),FORMAT([Value]*maxAxis/4,"#,0")) & "</text>","")
VAR bars = CONCATENATEX(accountRowsRanked,
 VAR yrow=278+([@rank]-1)*46
 VAR aw = 580*DIVIDE(SWITCH(mode,"% Index",DIVIDE([@a],[@b]),"Budget",[@b],[@a]),maxAxis)
 VAR bx = 830+580*DIVIDE(IF(indexed,1,[@b]),maxAxis)
 VAR safeName = SUBSTITUTE(SUBSTITUTE([@ledger],"&","&amp;"),"<","&lt;")
 VAR labelName = SUBSTITUTE(safeName,"Service Contracts","contracts")
 RETURN "<text x='490' y='" & yrow & "' font-size='16' font-weight='600' fill='#1B2F3F'>" & IF(LEN(labelName)>33,LEFT(labelName,30)&"…",labelName) & "</text><text x='490' y='" & yrow+18 & "' font-size='16' fill='#4F6A7A'>" & FORMAT([@a],"#,0.0") & " / " & FORMAT([@b],"#,0.0") & "M</text><rect x='830' y='" & yrow-12 & "' width='580' height='20' rx='5' fill='#f3f4f2'/><rect x='830' y='" & yrow-12 & "' width='" & FORMAT(aw,"0.0","en-US") & "' height='20' rx='5' fill='#D04A3A'><title>" & safeName & ": actual $" & FORMAT([@a],"#,0.0") & "M; budget $" & FORMAT([@b],"#,0.0") & "M</title></rect><path d='M" & FORMAT(bx,"0.0","en-US") & " " & yrow-17 & "v30' stroke='#1B2F3F' stroke-width='3'/><text x='1600' y='" & yrow+3 & "' font-size='19' font-weight='700' fill='#D04A3A' text-anchor='end'>" & IF(indexed,FORMAT(DIVIDE([@delta],[@b]),"+0.0%;-0.0%"),FORMAT([@delta],"+$#,0.0;-$#,0.0")&"M · "&FORMAT(DIVIDE([@delta],[@b]),"+0%;-0%")) & "</text>","",[@rank],ASC)
VAR heatRows = UNION(SELECTCOLUMNS(FILTER(accountRowsRanked,[@rank]<=3),"@label",[@ledger],"@row",[@rank]),ROW("@label","Payroll","@row",4))
VAR monthCellValues = GENERATE(heatRows,VAR ledger=[@label] RETURN ADDCOLUMNS(GENERATESERIES(1,12),"@v",VAR mm=[Value] RETURN CALCULATE(SWITCH(mode,"Actual",[TL Actual M],"Budget",[TL Budget M],"% Index",100*DIVIDE([TL Actual M],[TL Budget M]),[TL Actual M]-[TL Budget M]),REMOVEFILTERS(gold_dim_date),gold_dim_date[Year]=yy,gold_dim_date[MonthNumber]=mm,REMOVEFILTERS(gold_dim_operating_account),TREATAS({ledger},gold_dim_operating_account[GeneralLedger]))))
VAR heat = CONCATENATEX(monthCellValues,
 VAR px=810+([Value]-1)*64
 VAR py=643+([@row]-1)*42
 VAR val=[@v]
 VAR heatSignal=IF(indexed,val-100,IF(mode IN {"Actual","Budget"},ABS(val),val))
 VAR opacity=IF(ISBLANK(val),0.04,0.08+0.65*MIN(ABS(heatSignal)/100,1))
 RETURN "<rect x='" & px & "' y='" & py & "' width='58' height='34' rx='5' fill='" & IF(heatSignal>=0,"#D04A3A","#4F6A7A") & "' fill-opacity='" & FORMAT(opacity,"0.00","en-US") & "'><title>" & SUBSTITUTE([@label],"&","&amp;") & " · " & FORMAT(DATE(yy,[Value],1),"MMM") & ": " & FORMAT(val,"+$#,0.0;-$#,0.0") & "M</title></rect><text x='" & px+29 & "' y='" & py+22 & "' text-anchor='middle' font-size='16' font-weight='600' fill='#1B2F3F'>" & IF(ISBLANK(val),"—",IF(indexed,FORMAT(val,"0")&"%",IF(mode IN {"Actual","Budget"},FORMAT(val,"0"),FORMAT(val,"+0;-0;0")))) & "</text>","")
VAR heatLabels=CONCATENATEX(heatRows,"<text x='490' y='" & 665+([@row]-1)*42 & "' font-size='15' fill='#1B2F3F'>" & SUBSTITUTE(SUBSTITUTE([@label],"Service Contracts","contracts"),"&","&amp;") & "</text>","",[@row],ASC)
VAR monthLabels=CONCATENATEX(GENERATESERIES(1,12),"<text x='" & 839+([Value]-1)*64 & "' y='626' font-size='16' fill='#4F6A7A' text-anchor='middle'>" & FORMAT(DATE(yy,[Value],1),"MMM") & "</text>","")
VAR story = CONCATENATEX(FILTER(accountRowsRanked,[@rank]<=2),
 VAR sy=210+([@rank]-1)*245
 VAR nm=[@ledger]
 VAR pts=CONCATENATEX(GENERATESERIES(1,12),VAR mm=[Value] VAR v=MAXX(FILTER(monthCellValues,[@label]=nm && [Value]=mm),[@v]) RETURN FORMAT(32+(mm-1)*31,"0") & "," & FORMAT(sy+176-48*DIVIDE(v,MAX(1,MAXX(FILTER(monthCellValues,[@label]=nm),ABS([@v])))),"0.0","en-US")," ",[Value],ASC)
 RETURN "<text x='30' y='" & sy & "' font-size='25' font-weight='700' fill='white'>" & SUBSTITUTE(nm,"Service Contracts","contracts") & "</text><text x='30' y='" & sy+59 & "' font-size='44' font-weight='700' fill='#FFAA98'>" & FORMAT([@delta],"+$#,0.0;-$#,0.0") & "M</text><text x='30' y='" & sy+89 & "' font-size='15' fill='#CDD8DE'>Actual $" & FORMAT([@a],"#,0.0") & "M / plan $" & FORMAT([@b],"#,0.0") & "M</text><polyline points='" & pts & "' fill='none' stroke='#D04A3A' stroke-width='2.5'/><text x='30' y='" & sy+202 & "' font-size='16' fill='#CDD8DE'>Jan–Dec " & SWITCH(mode,"Actual","actual","Budget","budget","% Index","index","variance") & " · separate scale</text>","",[@rank],ASC)
RETURN IF([TL Valid Year]<>1,"Select one reporting year",
[_css] & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1640 860' style='display:block;width:100%;height:auto;font-family:Segoe UI,Arial' role='img' aria-label='Cost pressure dashboard: ranked budget comparisons and monthly variance heatmap'><rect width='1640' height='860' fill='#F4F4EE'/><text x='0' y='24' font-size='16' font-weight='600' fill='#D04A3A' letter-spacing='1.2'>02 / COST PRESSURE</text><text x='0' y='68' font-size='29' font-weight='700' fill='#1B2F3F'>" & SUBSTITUTE(d1,"&","&amp;") & " and " & LOWER(SUBSTITUTE(d2,"Service Contracts","contracts")) & " added $" & FORMAT(pressure,"#,0.0") & "M above plan.</text><text x='0' y='104' font-size='16' fill='#4F6A7A'>Jan–Dec " & yy & " · NYCT non-reimbursable expenses · Rank the upward variances, then inspect the timing.</text><rect x='0' y='145' width='430' height='700' rx='20' fill='#1B2F3F'/><rect x='460' y='145' width='1180' height='380' rx='20' fill='white'/><rect x='460' y='545' width='1180' height='300' rx='20' fill='white'/><text x='30' y='176' font-size='16' font-weight='600' fill='#FFAA98'>INVESTIGATE FIRST</text>" & story & "<path d='M30 680H400' stroke='#e3e6e3'/><circle cx='44' cy='720' r='14' fill='#f9ede9'/><text x='44' y='725' text-anchor='middle' font-size='17' fill='#D04A3A'>?</text><text x='70' y='725' font-size='15' font-weight='600' fill='white'>What should management explain?</text><text x='30' y='765' font-size='15' fill='#CDD8DE'>Recurring cost, settlement timing,</text><text x='30' y='788' font-size='15' fill='#CDD8DE'>or an accounting adjustment?</text><text x='30' y='821' font-size='16' fill='#CDD8DE'>Variance locates pressure; it does not establish cause.</text><text x='490' y='184' font-size='22' font-weight='700' fill='#1B2F3F'>Five accounts to inspect</text><text x='490' y='211' font-size='14' fill='#4F6A7A'>" & IF(indexed,"Budget = 100% · ranking stays fixed by dollar variance","Actual spending · black marker = adopted budget · $ millions") & "</text><text x='1600' y='242' text-anchor='end' font-size='16' fill='#4F6A7A'>% / $ above plan</text>" & ticks & bars & "<text x='490' y='506' font-size='16' fill='#4F6A7A'>Shared scale · " & IF(indexed,"Index = actual ÷ adopted budget; compares relative pressure.","Zero-based bars compare dollar impact; labels show actual / plan.") & "</text><text x='490' y='583' font-size='22' font-weight='700' fill='#1B2F3F'>Monthly account detail</text><text x='1600' y='583' text-anchor='end' font-size='16' fill='#4F6A7A'>" & IF(mode IN {"Actual","Budget"},mode & " · $M",IF(indexed,"100% = adopted plan","− Below / + Above plan")) & "</text>" & monthLabels & heatLabels & heat & "<text x='490' y='827' font-size='16' fill='#4F6A7A'>" & SWITCH(mode,"Actual","Monthly actual · $M","Budget","Monthly adopted budget · $M","% Index","Actual / budget · 100% = on plan","Monthly actual minus adopted budget · signed $M") & " · stronger shading = larger magnitude</text></svg>")
