{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": 280,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#e3e3e3",
      "labelFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFont": "Segoe UI"
    },
    "background": "white"
  },
  "transform": [
    {
      "window": [
        {
          "op": "sum",
          "field": "TL Bridge Value M",
          "as": "running"
        }
      ],
      "sort": [
        {
          "field": "Step",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.Step === 5 ? 0 : datum.running - datum[\"TL Bridge Value M\"]",
      "as": "start"
    },
    {
      "calculate": "datum.Step === 5 ? datum[\"TL Bridge Value M\"] : datum.running",
      "as": "end"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "TL Bridge Label",
          "type": "nominal",
          "sort": {
            "field": "Step"
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelLimit": 110
          }
        },
        "y": {
          "field": "start",
          "type": "quantitative",
          "title": "Variance · USD millions"
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "condition": [
            {
              "test": "datum.Step === 5",
              "value": "#18232b"
            },
            {
              "test": "datum[\"TL Bridge Value M\"] < 0",
              "value": "#526b7a"
            }
          ],
          "value": "#cf493a"
        },
        "tooltip": [
          {
            "field": "TL Bridge Label",
            "type": "nominal"
          },
          {
            "field": "TL Bridge Value M",
            "type": "quantitative",
            "format": "+,.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "TL Bridge Label",
          "type": "nominal",
          "sort": {
            "field": "Step"
          }
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "TL Bridge Value M",
          "type": "quantitative",
          "format": "+,.1f"
        }
      }
    }
  ]
}