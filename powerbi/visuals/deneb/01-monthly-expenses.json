{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": 280,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#e3e3e3",
      "labelFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFont": "Segoe UI"
    },
    "background": "white"
  },
  "transform": [
    {
      "fold": [
        "TL Actual M",
        "TL Budget M"
      ],
      "as": [
        "Series",
        "Amount"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true
      },
      "encoding": {
        "x": {
          "field": "MonthName",
          "type": "nominal",
          "sort": {
            "field": "MonthNo"
          },
          "axis": {
            "title": null,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Amount",
          "type": "quantitative",
          "scale": {
            "zero": false
          },
          "title": "USD millions (truncated axis)"
        },
        "color": {
          "field": "Series",
          "type": "nominal",
          "scale": {
            "domain": [
              "TL Actual M",
              "TL Budget M"
            ],
            "range": [
              "#18232b",
              "#778b98"
            ]
          },
          "legend": null
        },
        "strokeDash": {
          "field": "Series",
          "type": "nominal",
          "scale": {
            "range": [
              [
                1,
                0
              ],
              [
                5,
                4
              ]
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "MonthName",
            "type": "nominal"
          },
          {
            "field": "Series",
            "type": "nominal"
          },
          {
            "field": "Amount",
            "type": "quantitative",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MonthNo === 12"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "MonthName",
          "type": "nominal",
          "sort": {
            "field": "MonthNo"
          },
          "axis": {
            "title": null,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Amount",
          "type": "quantitative"
        },
        "text": {
          "field": "Series",
          "type": "nominal"
        },
        "color": {
          "field": "Series",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ]
}